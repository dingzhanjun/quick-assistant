# Production settings. For docker-compose.yml copy this file to .env; for docker-compose.prod.yml (CI pipeline) to .env.prod.
# Fill it in, then `chmod 600` it. Never commit it. Generate every secret fresh:  openssl rand -hex 32

# --- Where the site lives -----------------------------------------------------------------------------------
# Public hostname WITHOUT https://, e.g. app.example.com (DNS A record pointing at this server for caddy mode)
DOMAIN=
# caddy  = HTTPS on ports 80/443 (needs the A record and open ports)
# tunnel = Cloudflare Tunnel, no open ports (also set CLOUDFLARE_TUNNEL_TOKEN)
COMPOSE_PROFILES=caddy
CLOUDFLARE_TUNNEL_TOKEN=
# Where the images come from: <IMAGE_PREFIX>/{web,migrate,agent}:<IMAGE_TAG>. Leave both empty to use the official public images
# (ghcr.io/dingzhanjun/quick-assistant, latest). For your own fork set ghcr.io/<github-user-or-org>/<repo>, all lowercase.
IMAGE_PREFIX=
#IMAGE_TAG=latest

# --- Secrets (generate each one with: openssl rand -hex 32) -------------------------------------------------
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
AGENT_API_KEY=

# --- Who administers the platform ---------------------------------------------------------------------------
# Comma-separated emails that become platform admins (they sign in with Google).
PLATFORM_ADMIN_EMAILS=
# Optional, brand-new systems only: no Google sign-in yet? Set a password (12+ characters) and the FIRST email above
# becomes an admin with it. Sign in, set up Google, then DELETE this line and redeploy.
PLATFORM_ADMIN_PASSWORD=

# --- Phone calls (LiveKit) ----------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must equal the agent name in your LiveKit SIP dispatch rule (see docs/SYSTEM_SETUP.md, section 7)
AGENT_NAME=

# --- AI providers (Deepgram + at least one language model) --------------------------------------------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Sign-in with Google ------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend). Without it, nobody gets verification or order emails ------------------------------------
RESEND_API_KEY=
# e.g. Quick Assistant <orders@yourdomain.com>  (the domain must be verified in Resend)
EMAIL_FROM=

# --- Optional: text customers a link to their order (Twilio or Plivo). Empty = off --------------------------
SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# --- Optional tuning (defaults are fine to start) -----------------------------------------------------------
#AUTH_IP_HEADER=cf-connecting-ip     # behind Cloudflare; otherwise leave unset
#AGENT_REPLICAS=1                    # voice agent containers
#AGENT_MAX_CALLS=                    # hard cap of simultaneous calls per container
#BACKUP_HOUR=3                       # UTC hour of the daily backup
#BACKUP_KEEP=14                      # backups kept
#RETENTION_CALLER_DAYS=90            # caller numbers are purged after this many days
#VOICE_MODE=pipeline                 # pipeline (default) or the experimental grok (needs XAI_API_KEY)
#XAI_API_KEY=
