{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test": "ls tests/*.test.ts | grep -v '^tests/jobs' | xargs node --experimental-test-module-mocks --import tsx --test && node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 tests/jobs.test.ts tests/jobs-admin.test.ts",
    "test:e2e": "playwright test",
    "agent:build": "sh scripts/build-agent.sh",
    "worker": "tsx src/worker/main.ts",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --target=node22 --format=cjs --tsconfig=tsconfig.json --outfile=dist/worker.cjs --log-level=warning"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "better-auth": "^1.7.10",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rsuite": "^6.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yaml": "^2.9.1",
    "esbuild": "0.25.12"
  },
  "packageManager": "pnpm@10.33.2"
}
