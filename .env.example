# Shared
DATABASE_URL=postgres://quickassistant:quickassistant@localhost:5432/quickassistant

# Web -> agent/API shared secret (agent calls the web API with this)
AGENT_API_KEY=change-me
WEB_API_URL=http://localhost:3000

# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must equal the agent name in your LiveKit SIP dispatch rule (`lk sip dispatch list` -> Agents column). With
# a name set, LiveKit only sends this worker the calls that rule names (explicit dispatch). Empty = unnamed worker.
AGENT_NAME=

# Agent providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Experimental: set VOICE_MODE=grok to use xAI's speech-to-speech model instead of the
# Deepgram + LLM + TTS pipeline (needs XAI_API_KEY; the LLM setting in /admin is then not used)
VOICE_MODE=pipeline
# Menus with more dishes than this are not pasted into the prompt: the agent gets a list of dish names and
# a search_menu tool instead (0 = always search). Small menus keep the full menu in the prompt.
MENU_SEARCH_THRESHOLD=40
XAI_API_KEY=
GROK_VOICE=ara
GROK_MODEL=grok-voice-latest
# Optional: speaking speed multiplier for Grok voice, e.g. 0.9 (slower) or 1.1 (faster)
GROK_SPEED=

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become platform admins (sign in with Google once)
PLATFORM_ADMIN_EMAILS=you@example.com
# Optional, for a BRAND-NEW system with no admin yet (and no Google sign-in set up): on startup, if no platform admin exists, the
# FIRST email above is created as the admin with this password (at least 12 characters). Password sign-in for admin emails works
# only while this is set. Sign in, set up Google sign-in, then DELETE this line and redeploy to go back to Google-only admins.
PLATFORM_ADMIN_PASSWORD=

# Dev only: console mode has no SIP call; pretend this number was dialed (seeded demo)
DEV_CALLED_NUMBER=+14155550100

DEEPSEEK_API_KEY=

# Optional: real email delivery (Resend). Without it, verification links are printed in the web server console.
RESEND_API_KEY=
EMAIL_FROM=
# Text messages to customers: after an order the phone agent offers to text a link to it (needs a provider).
#   SMS_PROVIDER=twilio|plivo|log (log = print to the web console, for development). Empty = texting is off.
#   US numbers need carrier registration (A2P 10DLC or a verified toll-free number) before messages are delivered.
SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Header carrying the real client IP for auth rate limiting. Caddy: leave default (x-forwarded-for).
# Cloudflare tunnel: cf-connecting-ip.
#AUTH_IP_HEADER=x-forwarded-for

# If xAI/Grok is unusable (out of credit...): apology = tell the caller about a system problem and hang up;
# pipeline = take the order with Deepgram + the admin-selected LLM instead.
#GROK_FALLBACK=apology

# Call limits (web server). Raise while testing so your own number is not refused ("rate_limited").
#MAX_CALLS_PER_CALLER_PER_HOUR=5
#MAX_CONCURRENT_CALLS_PER_TENANT=3

# Scaling / background work (web server). All optional.
#MENU_CACHE_SECONDS=10        # per-process cache of each restaurant's menu for the phone agent (0 = off)
#UNACK_ALERT_MINUTES=5        # reminder email when an order stays "new" this long
#JOB_WORKER=off               # do not run the email/text job loop in this web process (production: the `worker` service runs it, web has off)
#JOB_TICK_SECONDS=5           # how often the worker looks for due jobs
#WORKER_LAG_SECONDS=120       # the worker's /health and the web app's /api/health/worker answer 503 when a due job has waited longer than this
#WORKER_HEALTH_PORT=3000      # port of the worker program's /health endpoint (pnpm --filter web worker, or the worker container)
#DATABASE_LISTEN_URL=         # direct Postgres address for LISTEN when DATABASE_URL is a pooler

# Kitchen print agents (Go program on a Raspberry Pi). The web image hosts the agent downloads itself (/printer/, built from
# apps/printer-agent), so leave these empty. Set BOTH only to host the files elsewhere (an https folder holding
# order-printer-linux-<arm64|arm|amd64> and the matching .sha256 files) and the version agents should run.
#PRINT_AGENT_VERSION=
#PRINT_AGENT_BASE_URL=
